# Variables de entorno del backend — NO comitear .env real
# Copiar este archivo como .env y rellenar los valores reales.

# ─── SMTP ───────────────────────────────────────────────────
# Gmail: usa una App Password en https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password-aqui
MAIL_FROM_ADDRESS=tu-correo@gmail.com
MAIL_FROM_NAME=Integral Eléctrica Web

# ─── Destinatario ───────────────────────────────────────────
MAIL_TO_ADDRESS=tu-correo-personal@gmail.com

# ─── CORS ───────────────────────────────────────────────────
# URL del frontend (sin barra final)
FRONTEND_URL=http://localhost:8081
