# ──────────────────────────────────────────────────────────────────────────────
# Integral Eléctrica — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el fichero .env real al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Registro Docker (para deploy.ps1 y docker-compose.portainer.yml) ─────────
# Docker Hub username o URL de tu registro privado (sin barra final)
REGISTRY=tuusuario
TAG=latest

# ─── Frontend ─────────────────────────────────────────────────────────────────
# URL pública del backend, tal como la ve el NAVEGADOR del usuario (sin barra final)
# Local:       http://localhost:8082
# Producción:  http://IP_SERVIDOR:8082   o   https://api.tu-dominio.com
VITE_API_URL=http://localhost:8082

# ─── Backend — SMTP ───────────────────────────────────────────────────────────
# Gmail: genera una App Password en https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAIL_FROM_ADDRESS=tu-correo@gmail.com
MAIL_FROM_NAME=Integral Eléctrica Web

# ─── Backend — Destinatario ───────────────────────────────────────────────────
# Correo al que llegarán los mensajes del formulario de contacto
MAIL_TO_ADDRESS=tu-correo-destino@gmail.com

# ─── Backend — CORS ───────────────────────────────────────────────────────────
# URL del frontend tal como la ve el NAVEGADOR (sin barra final)
# Local:       http://localhost:8081
# Producción:  http://IP_SERVIDOR:8081   o   https://tu-dominio.com
FRONTEND_URL=http://localhost:8081
